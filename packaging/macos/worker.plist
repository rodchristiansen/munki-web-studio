<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>io.github.rodchristiansen.munki-web-studio.worker</string>
	<key>ProgramArguments</key>
	<array>
		<string>@PREFIX@/run-worker</string>
	</array>
	<key>UserName</key>
	<string>_mwsworker</string>
	<key>GroupName</key>
	<string>_mwsworker</string>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<dict>
		<key>SuccessfulExit</key>
		<false/>
	</dict>
	<key>ThrottleInterval</key>
	<integer>30</integer>
	<key>StandardOutPath</key>
	<string>/Library/Logs/munki-web-studio-worker.log</string>
	<key>StandardErrorPath</key>
	<string>/Library/Logs/munki-web-studio-worker.log</string>
</dict>
</plist>
